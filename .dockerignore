# Dependencies and caches
node_modules/
npm-debug.log*
.yarn-cache/
.pnpm-store/

# Local environment
.env
.env.*

# VCS
.git/
.gitignore
.gitattributes

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
